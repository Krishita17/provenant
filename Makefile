# Provenant — AI Bill of Materials (AIBOM) generator
# Author: Krishita Sanjay Choksi
#
# All targets run fully OFFLINE against bundled synthetic projects and cached
# metadata fixtures. No network access is required for any target below.

PY ?= python
RUN := PYTHONPATH=src $(PY) -m provenant.cli
SEED ?= 7

# Default worked example (generated by `make data`).
PROJECT ?= examples/synthetic/finetune_stack
OUT     ?= results/finetune_stack

.PHONY: help
help:
	@echo "Provenant targets:"
	@echo "  make setup     Install Python dependencies (into the active environment)"
	@echo "  make data      Generate synthetic ML projects + ground-truth BOMs (seed=$(SEED))"
	@echo "  make discover  Discover AI components in \$$PROJECT"
	@echo "  make resolve   Resolve component metadata (offline, from fixtures)"
	@echo "  make lineage   Reconstruct the provenance graph"
	@echo "  make analyze   Run the license/provenance risk analyzer"
	@echo "  make bom       Assemble the CycloneDX ML-BOM + SPDX AI-profile AIBOM"
	@echo "  make report    Render the AIBOM + provenance graph + risk report"
	@echo "  make all       Run the full pipeline on \$$PROJECT"
	@echo "  make eval      Score discovery/lineage/license accuracy vs ground truth"
	@echo "  make figures   Regenerate every figure and the architecture diagram"
	@echo "  make reports   Regenerate the committed worked example in reports/"
	@echo "  make test      Run the test suite"
	@echo "  make clean     Remove generated run artifacts"

.PHONY: setup
setup:
	$(PY) -m pip install -r requirements.txt
	$(PY) -m pip install -e .

.PHONY: data
data:
	$(RUN) gen-data --out examples --seed $(SEED)

.PHONY: discover
discover:
	$(RUN) discover $(PROJECT) --out $(OUT)

.PHONY: resolve
resolve:
	$(RUN) resolve $(PROJECT) --out $(OUT)

.PHONY: lineage
lineage:
	$(RUN) lineage $(PROJECT) --out $(OUT)

.PHONY: analyze
analyze:
	$(RUN) analyze $(PROJECT) --out $(OUT)

.PHONY: bom
bom:
	$(RUN) bom $(PROJECT) --out $(OUT)

.PHONY: report
report:
	$(RUN) report $(PROJECT) --out $(OUT)

.PHONY: all
all:
	$(RUN) all $(PROJECT) --out $(OUT)

.PHONY: eval
eval:
	$(RUN) eval --projects examples/synthetic --out results

.PHONY: figures
figures: eval
	$(RUN) figures --results results --out figures

.PHONY: reports
reports:
	$(RUN) all $(PROJECT) --out reports/finetune_stack

.PHONY: test
test:
	PYTHONPATH=src $(PY) -m pytest -q

.PHONY: clean
clean:
	rm -rf results/* .work
	@echo "Cleaned generated run artifacts (committed worked examples under reports/ and figures/ are left in place)."
