{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.example/schemas/cyclonedx-mlbom.schema.json",
  "title": "CycloneDX 1.6 ML-BOM (Provenant profile)",
  "$comment": "A self-contained subset of the upstream CycloneDX 1.6 JSON schema covering the fields Provenant emits for an ML-BOM. Validation runs fully offline. It is intentionally structural; it does not supersede the official schema.",
  "type": "object",
  "required": ["bomFormat", "specVersion", "version", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "type": "string", "enum": ["1.5", "1.6"] },
    "serialNumber": { "type": "string", "pattern": "^urn:uuid:" },
    "version": { "type": "integer", "minimum": 1 },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "component": { "type": "object" }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "machine-learning-model", "data", "library",
              "application", "framework", "file"
            ]
          },
          "bom-ref": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "licenses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "license": {
                  "type": "object",
                  "anyOf": [
                    { "required": ["id"] },
                    { "required": ["name"] }
                  ]
                }
              }
            }
          },
          "externalReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "url"],
              "properties": {
                "type": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "modelCard": { "type": "object" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subjects", "text"],
        "properties": {
          "subjects": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" }
        }
      }
    }
  }
}
